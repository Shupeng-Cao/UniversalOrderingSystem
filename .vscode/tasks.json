{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: gcc.exe 生成活动文件",
            "command": "D:\\installation\\strawberry\\c\\bin\\gcc.exe",
            "args": [
                "args": [
                    "-fdiagnostics-color=always",
                    "-g",
                    "${workspaceFolder}/main.c",
                    "${workspaceFolder}/Data/data.c",
                    "${workspaceFolder}/User/user.c",
                    "${workspaceFolder}/Product/product.c",
                    "${workspaceFolder}/Order/order.c",
                    "${workspaceFolder}/Transaction/transaction.c",
                    "${workspaceFolder}/Statistics/statistics.c",
                    "${workspaceFolder}/UI/customer_ui.c",
                    "${workspaceFolder}/UI/manager_ui.c",
                    "-o",
                    "${workspaceFolder}/main.exe"
                ]
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "调试器生成的任务。"
        }
    ],
    "version": "2.0.0"
}